<!DOCTYPE html>
<html lang="{{@site.locale}}" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="{{#if @custom.cor_destaque}}{{@custom.cor_destaque}}{{else}}#00a859{{/if}}" />
    <title>{{meta_title}}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;0,8..60,900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="{{asset "css/screen.css"}}" />

    <style>:root{
        --brand-green: #00a859;
        --brand-green-dark: #065f46;
        --brand-navy: #062b1a;
        --brand-red: #d60000;
        {{#if @custom.cor_destaque}}
            --urgent: {{@custom.cor_destaque}};
            --usat-green: {{@custom.cor_destaque}};
            --usat-blue: {{@custom.cor_destaque}};
            --brand: {{@custom.cor_destaque}};
        {{/if}}
        {{#if @site.accent_color}}
            --brand: {{@site.accent_color}};
        {{/if}}
    }</style>

    {{!-- Suporte a fontes personalizadas do Ghost (Design > Brand) --}}
    {{#if @site.heading_font}}<style>h1,h2,h3,h4,h5,h6,.site-brand,.hero-title,.card-title{font-family:{{@site.heading_font}},sans-serif}</style>{{/if}}
    {{#if @site.body_font}}<style>body{font-family:{{@site.body_font}},sans-serif}</style>{{/if}}

    {{ghost_head}}
</head>
<body class="{{body_class}}">
    {{> topbar}}
    {{> site-header}}
    {{> main-nav}}

    {{!-- Anúncio topo (leaderboard) --}}
    {{> ad zone="leaderboard" filter="tag:hash-ad-leaderboard" limit="6"}}

    <main id="site-main" class="site-main">
        {{{body}}}
    </main>

    {{> site-footer}}

    {{> popup}}

    {{> chat}}

    {{ghost_foot}}
    <script src="{{asset "js/articles-data.js"}}"></script>
    <script src="{{asset "js/main.js"}}"></script>
</body>
</html>
