{{!< default}}

<div class="container usat-archive-wrap">
    <header class="usat-archive-head">
        <span class="usat-kicker-lg">COBERTURA COMPLETA</span>
        <h1 class="usat-archive-title">Todas as Notícias</h1>
        <p class="usat-archive-desc">Acompanhe as reportagens, análises e acontecimentos de Mato Grosso e do Brasil.</p>
    </header>

    <div class="usat-section-grid">
        {{#foreach posts}}
            {{> article-card size="compact"}}
        {{/foreach}}
    </div>

    {{> pagination}}
</div>
