{{!-- Bloco AO VIVO. Em tempo real: se você informar o ID do canal (Design →
      youtube_canal_id), embute a transmissão AO VIVO ATUAL do canal (atualiza
      sozinha). Senão, usa um vídeo específico (youtube_live_id); senão, um link
      para a transmissão. O JS tira o mudo no 1º toque/clique (o navegador não
      deixa começar com som). Canais que bloqueiam incorporação (ex.: CazéTV)
      mostram "vídeo indisponível" — use o link do YouTube. --}}
<aside class="live-box" aria-label="Ao vivo">
    <h2 class="rail-title rail-live"><span class="live-dot"></span> AO VIVO</h2>
    {{#if @custom.youtube_canal_id}}
        <div class="live-embed">
            <iframe src="https://www.youtube.com/embed/live_stream?channel={{@custom.youtube_canal_id}}&autoplay=1&mute=1&playsinline=1&rel=0&modestbranding=1&iv_load_policy=3&enablejsapi=1&origin={{@site.url}}"
                title="Ao vivo" loading="lazy"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
        </div>
        <a class="live-yt-fallback" href="{{#if @custom.youtube_canal}}{{@custom.youtube_canal}}{{else}}https://www.youtube.com/{{/if}}" target="_blank" rel="noopener">Não carregou? Assista no YouTube ↗</a>
    {{else}}
        {{#if @custom.youtube_live_id}}
            {{#if @custom.youtube_embed}}
                <div class="live-embed">
                    <iframe src="https://www.youtube.com/embed/{{@custom.youtube_live_id}}?rel=0&autoplay=1&mute=1&playsinline=1&modestbranding=1&iv_load_policy=3&enablejsapi=1&origin={{@site.url}}"
                        title="Ao vivo" loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
                <a class="live-yt-fallback" href="https://www.youtube.com/watch?v={{@custom.youtube_live_id}}" target="_blank" rel="noopener">Não carregou? Assista no YouTube ↗</a>
            {{else}}
                <a class="live-thumb js-yt" href="https://www.youtube.com/watch?v={{@custom.youtube_live_id}}" data-yt="{{@custom.youtube_live_id}}" target="_blank" rel="noopener">
                    <img src="https://img.youtube.com/vi/{{@custom.youtube_live_id}}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/{{@custom.youtube_live_id}}/hqdefault.jpg'" alt="Assistir à transmissão ao vivo" loading="lazy" />
                    <span class="live-badge"><span class="live-dot"></span> AO VIVO</span>
                    <span class="live-play">▶</span>
                    <span class="live-cta">Clique para assistir ao vivo</span>
                </a>
            {{/if}}
        {{else}}
            <a class="live-placeholder" href="{{#if @custom.youtube_canal}}{{@custom.youtube_canal}}{{else}}https://www.youtube.com/{{/if}}" target="_blank" rel="noopener">
                <span class="live-badge"><span class="live-dot"></span> AO VIVO</span>
                <strong>Transmissão ao vivo</strong>
                <small>Toque para assistir no YouTube</small>
            </a>
        {{/if}}
    {{/if}}
</aside>
