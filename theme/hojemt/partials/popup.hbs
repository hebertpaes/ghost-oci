{{!-- Popup newsletter (1x por sessao) + Picture-in-Picture flutuante --}}
<div class="hoje-popup" id="hojePopup" role="dialog" aria-modal="true" aria-labelledby="hojePopupTitle" hidden>
  <div class="hoje-popup-backdrop" data-popup-close></div>
  <div class="hoje-popup-box">
    <button class="hoje-popup-x" type="button" aria-label="Fechar" data-popup-close>&times;</button>
    <span class="hoje-popup-badge">HOJE MT</span>
    <h3 id="hojePopupTitle" class="hoje-popup-title">Receba as noticias de Mato Grosso</h3>
    <p class="hoje-popup-text">Politica, economia, cidades e esportes direto no seu e-mail. E gratis.</p>
    <form class="hoje-popup-form" data-members-form="signup">
      <input class="hoje-popup-input" data-members-email type="email" required placeholder="seu@email.com" aria-label="E-mail">
      <button class="hoje-popup-cta" type="submit">Quero receber</button>
    </form>
    <a class="hoje-popup-skip" href="#" data-popup-close>Agora nao, obrigado</a>
  </div>
</div>

{{!-- Botao Picture-in-Picture (so aparece quando ha video na pagina) --}}
<button class="hoje-pip-btn" id="hojePipBtn" type="button" aria-label="Assistir em janela flutuante" hidden>
  <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M19 11h-8v6h8v-6zm4 8V4.98C23 3.88 22.1 3 21 3H3c-1.1 0-2 .88-2 1.98V19c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2zm-2 .02H3V4.97h18v14.05z"/></svg>
  <span>Modo janela</span>
</button>

<script>
(function () {
  var popup = document.getElementById('hojePopup');
  if (popup) {
    var seen = false;
    try { seen = sessionStorage.getItem('hojePopupSeen') === '1'; } catch (e) {}
    if (!seen) { setTimeout(function () { popup.hidden = false; document.body.classList.add('hoje-popup-open'); }, 6000); }
    function closePopup(e) {
      if (e) e.preventDefault();
      popup.hidden = true;
      document.body.classList.remove('hoje-popup-open');
      try { sessionStorage.setItem('hojePopupSeen', '1'); } catch (e2) {}
    }
    popup.querySelectorAll('[data-popup-close]').forEach(function (el) { el.addEventListener('click', closePopup); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closePopup(); });
  }

  var pipBtn = document.getElementById('hojePipBtn');
  if (pipBtn && document.pictureInPictureEnabled) {
    function firstVideo() { return document.querySelector('video'); }
    if (firstVideo()) {
      pipBtn.hidden = false;
      pipBtn.addEventListener('click', function () {
        var v = firstVideo(); if (!v) return;
        if (document.pictureInPictureElement) { document.exitPictureInPicture(); return; }
        v.play().catch(function () {});
        v.requestPictureInPicture().catch(function () {});
      });
    }
  }
})();
</script>
