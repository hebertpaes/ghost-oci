{{!--
  Zona de publicidade com ROTAÇÃO e Banner da Casa Ultra-Limpo no estilo USA TODAY.
  Prioridade de exibição em cada zona:
    1. Campanhas pagas — POSTS no Ghost com tag #ad + tag da zona:
       • Imagem destacada → o banner (feature_image)
       • Excerpt          → URL de destino do clique
       • Tags             → #ad + #ad-leaderboard | #ad-video | #ad-vertical | #ad-sidebar | #ad-inarticle
    2. Banner enviado por UPLOAD no Design → Theme:
       • Zona topo (leaderboard): banner_home na CAPA / banner_post nas MATÉRIAS e páginas internas
       • Lateral: banner_sidebar  • Dentro da matéria: banner_inarticle
    3. Banner da casa genérico (banner_casa)
    4. Cartão institucional "Anuncie aqui"
--}}
<aside class="ad ad-{{zone}}" aria-label="Espaço Publicitário">
    {{#get "posts" filter=filter limit=limit order="published_at desc" as |ads|}}
        {{#if ads}}
            <div class="ad-rotator" data-interval="5000">
                {{#foreach ads}}
                    <a class="ad-banner ad-slide{{#if @first}} active{{/if}}"
                       href="{{#if custom_excerpt}}{{custom_excerpt}}{{else}}{{url}}{{/if}}"
                       target="_blank" rel="nofollow sponsored noopener" data-ad="{{slug}}">
                        {{#if feature_image}}
                            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="lazy" />
                        {{else}}
                            <span class="ad-text">{{title}}</span>
                        {{/if}}
                    </a>
                {{/foreach}}
            </div>
        {{else}}
            {{#match zone "leaderboard"}}
                {{#is "home"}}
                    {{#if @custom.banner_home}}
                        {{> ad-custom img=@custom.banner_home link=@custom.banner_home_link}}
                    {{else}}
                        {{> ad-house}}
                    {{/if}}
                {{else}}
                    {{#if @custom.banner_post}}
                        {{> ad-custom img=@custom.banner_post link=@custom.banner_post_link}}
                    {{else}}
                        {{> ad-house}}
                    {{/if}}
                {{/is}}
            {{else match zone "sidebar"}}
                {{#if @custom.banner_sidebar}}
                    {{> ad-custom img=@custom.banner_sidebar link=@custom.banner_sidebar_link}}
                {{else}}
                    {{!-- Banner padrão da zona: ABACS Cursos Online (300×250) --}}
                    <a class="ad-banner ad-house-custom" href="https://abacs.org.br/loja_virtual/index.php" target="_blank" rel="nofollow sponsored noopener" aria-label="ABACS Cursos Online — mais de 120 cursos com certificado">
                        <img class="ad-house-img" src="{{asset "img/banner-abacs-300x250.png"}}" alt="ABACS Cursos Online — mais de 120 cursos com certificado" loading="lazy" />
                    </a>
                {{/if}}
            {{else match zone "inarticle"}}
                {{#if @custom.banner_inarticle}}
                    {{> ad-custom img=@custom.banner_inarticle link=@custom.banner_inarticle_link}}
                {{else}}
                    {{!-- Banner padrão da zona: ABACS Cursos Online (728×90) --}}
                    <a class="ad-banner ad-house-custom" href="https://abacs.org.br/loja_virtual/index.php" target="_blank" rel="nofollow sponsored noopener" aria-label="ABACS Cursos Online — mais de 120 cursos com certificado">
                        <img class="ad-house-img" src="{{asset "img/banner-abacs-728x90.png"}}" alt="ABACS Cursos Online — mais de 120 cursos com certificado" loading="lazy" />
                    </a>
                {{/if}}
            {{else}}
                {{> ad-house}}
            {{/match}}
        {{/if}}
    {{/get}}
</aside>
