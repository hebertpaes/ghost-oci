{{!-- Chat flutuante estilo WhatsApp com assistente/IA.
      - chat_ativo: liga/desliga (Design).
      - whatsapp_redacao: número para "Falar no WhatsApp". --}}
{{#if @custom.chat_ativo}}
<div class="chat-widget" id="chatWidget"
     data-wa="{{@custom.whatsapp_redacao}}"
     data-nome="{{@site.title}}"
     data-url="{{@site.url}}">
    <button class="chat-fab" id="chatFab" aria-label="Abrir chat" aria-expanded="false">
        <svg class="chat-fab-wa" viewBox="0 0 32 32" width="30" height="30" aria-hidden="true"><path fill="currentColor" d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.1 1.6 5.9L4 29l8.3-1.6c1.7.9 3.6 1.4 5.7 1.4 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.7.7.7-3.6-.2-.4c-1-1.6-1.5-3.4-1.5-5.3 0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.4-7.3c-.3-.1-1.7-.9-2-1s-.5-.1-.7.1c-.2.3-.7 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6l.4-.5c.1-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.3 5.2 4.6.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.7-.7 2-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3z"/></svg>
    </button>

    <section class="chat-panel" id="chatPanel" role="dialog" aria-label="Chat" hidden>
        <header class="chat-head">
            <span class="chat-avatar">🤖</span>
            <div class="chat-head-info">
                <b class="chat-title">Assistente {{@site.title}}</b>
                <span class="chat-status"><span class="chat-online"></span> normalmente responde na hora</span>
            </div>
            <button class="chat-close" id="chatClose" type="button" aria-label="Fechar">×</button>
        </header>
        <div class="chat-body" id="chatBody" aria-live="polite"></div>
        <div class="chat-quick" id="chatQuick"></div>
        <form class="chat-form" id="chatForm" autocomplete="off">
            <input class="chat-input" id="chatInput" type="text" placeholder="Escreva sua mensagem…" aria-label="Mensagem" />
            <button class="chat-send" type="submit" aria-label="Enviar">➤</button>
        </form>
        <a class="chat-wa" id="chatWa" href="#" target="_blank" rel="noopener">💬 Falar no WhatsApp da redação</a>
    </section>
</div>
{{/if}}
