{{!-- Cartão de Notícia no estilo USA TODAY: Imagem Original 16:9 100% Visível e Limpa --}}
<article class="usat-card usat-card-{{#if size}}{{size}}{{else}}default{{/if}}">
    <a class="usat-card-media" href="{{url}}" tabindex="-1" aria-hidden="true">
        {{#if feature_image}}
            <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
        {{else}}
            <div class="usat-no-img-placeholder">
                <span class="usat-circle-dot sm"></span>
                <span>HOJE MT</span>
            </div>
        {{/if}}
        {{#primary_tag}}
            <span class="usat-card-tag">{{name}}</span>
        {{/primary_tag}}
    </a>
    <div class="usat-card-body">
        {{#primary_tag}}
            <a class="usat-kicker" href="{{url}}">{{name}}</a>
        {{/primary_tag}}
        <h3 class="usat-card-title"><a href="{{url}}">{{title}}</a></h3>
        <p class="usat-card-excerpt">{{excerpt words="20"}}</p>
        <div class="usat-card-meta">
            {{#if primary_author}}<span class="meta-author">Por {{primary_author.name}}</span>{{/if}}
            <time class="meta-date" datetime="{{date format="YYYY-MM-DD"}}">{{date format="DD/MM/YYYY"}}</time>
        </div>
    </div>
</article>
