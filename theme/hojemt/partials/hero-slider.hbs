{{!-- Hero Slider no estilo USA TODAY: Manchete Principal com Navegação Minimalista e Slides Dinâmicos --}}
<section class="usat-hero-slider" data-autoplay="6000" aria-label="Manchete Principal">
    {{#get "posts" include="tags,authors" filter="tag:-hash-ad" limit=@custom.slides_home order="featured desc, published_at desc" as |slides|}}
        {{#if slides}}
            <div class="usat-slider-track">
                {{#foreach slides}}
                    {{> slide}}
                {{/foreach}}
            </div>
            <button class="usat-slider-arrow prev" type="button" aria-label="Notícia Anterior">‹</button>
            <button class="usat-slider-arrow next" type="button" aria-label="Próxima Notícia">›</button>
            <div class="usat-slider-controls">
                <button class="usat-slider-pause" type="button" aria-label="Pausar / Retomar Slider">⏸</button>
                <div class="usat-slider-dots">
                    {{#foreach slides}}
                        <button class="usat-slider-dot{{#if @first}} active{{/if}}" type="button" data-go="{{@index}}" aria-label="Slide {{@number}}"></button>
                    {{/foreach}}
                </div>
            </div>
        {{/if}}
    {{/get}}
</section>
