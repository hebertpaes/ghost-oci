{{!-- Faixa Eleições 2026: contagem regressiva para o 1º turno (04/10/2026) e
      2º turno (25/10/2026) + link para a central de apuração /apuracao-2026/.
      Liga/desliga em Settings → Design → eleicoes_ativa. A contagem e o estado
      (faltam X dias / votação / apuração ao vivo) são calculados no main.js. --}}
{{#if @custom.eleicoes_ativa}}
<section class="eleicoes-banner container" aria-label="Eleições Gerais 2026">
    <a class="eleicoes-link" href="{{@site.url}}/apuracao-2026/">
