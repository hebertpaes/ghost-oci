        </div>
        <div class="eleicoes-right">
            <span class="eleicoes-countdown" id="eleicoesCountdown" data-t1="2026-10-04T08:00:00-03:00" data-t2="2026-10-25T08:00:00-03:00">04/10 e 25/10</span>
            <span class="eleicoes-cta">Acompanhe →</span>
        </div>
    </a>
