{{!< default}}

<div class="container usat-article-wrap">
    <div class="usat-archive-main">
        <header class="usat-author-header">
            {{#author}}
                {{#if profile_image}}
                    <img class="usat-author-avatar-lg" src="{{img_url profile_image size="s"}}" alt="{{name}}" />
                {{/if}}
                <div class="usat-author-info">
                    <span class="usat-kicker-lg">COLUNISTA &amp; AUTOR HOJE MT</span>
                    <h1 class="usat-author-name">{{name}}</h1>
                    {{#if bio}}<p class="usat-author-bio">{{bio}}</p>{{/if}}
                </div>
            {{/author}}
        </header>

        <div class="usat-section-grid">
            {{#foreach posts}}
                {{> article-card size="compact"}}
            {{else}}
                <p class="usat-section-empty">Nenhum artigo publicado por este autor ainda.</p>
            {{/foreach}}
        </div>

        {{> pagination}}
    </div>

    <aside class="usat-article-rail">
        {{> most-read}}
        {{> curtinhas}}
    </aside>
</div>
