<!--Opinião-->
{{!< default}}
{{!-- Template editorial "Opinião": coluna assinada. Autor em destaque (foto,
      nome, cargo), corpo serifado, aviso de responsabilidade e mini-bio ao fim. --}}
{{#post}}
<div class="container article-wrap">
    <article class="article article-coluna article-opiniao">
        <header class="article-head coluna-head">
            <span class="edit-badge badge-opiniao">Opinião</span>
            {{#primary_tag}}<a class="card-kicker" href="{{url}}">{{name}}</a>{{/primary_tag}}
            <h1 class="article-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-sub">{{custom_excerpt}}</p>{{/if}}
            {{> autor-linha}}
        </header>

        {{#if feature_image}}
            <figure class="article-hero">
                <img src="{{img_url feature_image size="xl"}}" alt="{{title}}" loading="lazy" onerror="this.closest('.article-hero').remove()" />
                {{#if feature_image_caption}}<figcaption class="fonte-credito">{{{feature_image_caption}}}</figcaption>{{/if}}
            </figure>
        {{/if}}

        <div class="gh-content gh-coluna">
            {{content}}
        </div>

        {{> leia-tambem}}

        {{> assinatura}}

        <div class="article-share">
            <span>Compartilhar:</span>
            <a href="https://wa.me/?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener">WhatsApp</a>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}" target="_blank" rel="noopener">Facebook</a>
            <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" target="_blank" rel="noopener">X</a>
        </div>

        {{> ad zone="inarticle" filter="tag:hash-ad-inarticle" limit="6"}}

        <section class="related">
            <h2 class="rail-title">Mais colunas</h2>
            <div class="section-grid">
                {{#get "posts" filter="id:-{{id}}+tag:colunas+tag:-hash-ad" limit="3" order="published_at desc" as |rel|}}
                    {{#if rel}}
                        {{#foreach rel}}{{> article-card size="compact"}}{{/foreach}}
                    {{else}}
                        {{#get "posts" filter="id:-{{id}}+tag:-hash-ad" limit="3" order="published_at desc" as |rel2|}}
                            {{#foreach rel2}}{{> article-card size="compact"}}{{/foreach}}
                        {{/get}}
                    {{/if}}
                {{/get}}
            </div>
        </section>

        {{#if comments_enabled}}
            <section class="article-comments">
                <h2 class="rail-title">Comentários</h2>
                {{comments}}
            </section>
        {{/if}}
    </article>

    <aside class="article-rail">
        {{> most-read}}
        {{> ad zone="sidebar" filter="tag:hash-ad-sidebar" limit="6"}}
    </aside>
</div>
{{/post}}
