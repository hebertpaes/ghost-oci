<!--Curtinha-->
{{!< default}}
{{!-- Template editorial "Curtinha": nota curta e direta. Layout estreito, sem
      barra lateral; ao fim, lista de outras curtinhas (tag interna #curtinha). --}}
{{#post}}
<div class="container article-wrap article-wrap-narrow">
    <article class="article article-curtinha">
        <header class="article-head">
            <span class="edit-badge badge-curtinha">Curtinha</span>
            {{#primary_tag}}<a class="card-kicker" href="{{url}}">{{name}}</a>{{/primary_tag}}
            <h1 class="article-title">{{title}}</h1>
            {{#if custom_excerpt}}<p class="article-sub">{{custom_excerpt}}</p>{{/if}}
            {{> byline}}
        </header>

        {{#if feature_image}}
            <figure class="article-hero">
                <img src="{{img_url feature_image size="l"}}" alt="{{title}}" loading="lazy" onerror="this.closest('.article-hero').remove()" />
                {{#if feature_image_caption}}<figcaption class="fonte-credito">{{{feature_image_caption}}}</figcaption>{{/if}}
            </figure>
        {{/if}}

        <div class="gh-content gh-curtinha">
            {{content}}
        </div>

        {{> leia-tambem}}

        <div class="article-share">
            <span>Compartilhar:</span>
            <a href="https://wa.me/?text={{encode title}}%20{{url absolute="true"}}" target="_blank" rel="noopener">WhatsApp</a>
            <a href="https://www.facebook.com/sharer/sharer.php?u={{url absolute="true"}}" target="_blank" rel="noopener">Facebook</a>
            <a href="https://twitter.com/intent/tweet?text={{encode title}}&url={{url absolute="true"}}" target="_blank" rel="noopener">X</a>
        </div>

        <section class="related">
            <h2 class="rail-title">Mais curtinhas</h2>
            {{#get "posts" filter="id:-{{id}}+tag:hash-curtinha+tag:-hash-ad" limit="6" order="published_at desc" as |cur|}}
                {{#if cur}}
                    <ul class="curtinhas-list">
                        {{#foreach cur}}<li><a href="{{url}}">{{#primary_tag}}<span class="curt-kicker">{{name}}</span>{{/primary_tag}}{{title}}</a></li>{{/foreach}}
                    </ul>
                {{else}}
                    <div class="section-grid">
                        {{#get "posts" filter="id:-{{id}}+tag:-hash-ad" limit="3" order="published_at desc" as |rel|}}
                            {{#foreach rel}}{{> article-card size="compact"}}{{/foreach}}
                        {{/get}}
                    </div>
                {{/if}}
            {{/get}}
        </section>
    </article>
</div>
{{/post}}
