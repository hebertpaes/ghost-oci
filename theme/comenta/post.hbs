{{!< default}}

{{#post}}
<article class="post {{post_class}}">
    <header class="post-header">
        {{#primary_tag}}<a class="post-tag" href="{{url}}">{{name}}</a>{{/primary_tag}}
        <h1 class="post-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="post-excerpt">{{custom_excerpt}}</p>{{/if}}
        <div class="post-meta">
            {{#primary_author}}<span class="post-author">{{name}}</span>{{/primary_author}}
            <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D [de] MMMM [de] YYYY"}}</time>
            {{#if reading_time}}<span>{{reading_time}}</span>{{/if}}
        </div>
    </header>

    {{#if feature_image}}
        <figure class="post-image">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
            {{#if feature_image_caption}}<figcaption>{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}

    <section class="post-content gh-content">
        {{content}}
    </section>

    <footer class="post-footer">
        {{#if tags}}
            <div class="post-tags">
                {{#foreach tags}}<a href="{{url}}" class="post-tag-chip">{{name}}</a>{{/foreach}}
            </div>
        {{/if}}
    </footer>
</article>

{{#if comments}}
    <section class="post-comments">{{comments}}</section>
{{/if}}
{{/post}}
