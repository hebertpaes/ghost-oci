{
  "name": "comenta",
  "description": "Tema Ghost limpo e moderno da Comenta — gradiente roxo/magenta, responsivo e rapido.",
  "version": "1.0.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Hebert Paes",
    "email": "contato@comenta.com.br"
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "comenta",
    "blog"
  ],
  "config": {
    "posts_per_page": 9,
    "image_sizes": {
      "xs": { "width": 160 },
      "s": { "width": 400 },
      "m": { "width": 750 },
      "l": { "width": 1000 },
      "xl": { "width": 2000 }
    },
    "card_assets": true,
    "custom": {
      "cor_primaria": {
        "type": "color",
        "default": "#7c3aed"
      },
      "cor_secundaria": {
        "type": "color",
        "default": "#db2777"
      },
      "mostrar_autor": {
        "type": "boolean",
        "default": true
      }
    }
  }
}
