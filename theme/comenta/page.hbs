{{!< default}}

{{#post}}
<article class="post page {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
    <header class="post-header">
        <h1 class="post-title">{{title}}</h1>
    </header>

    {{#if feature_image}}
        <figure class="post-image">
            <img src="{{img_url feature_image size="xl"}}" alt="{{title}}">
        </figure>
    {{/if}}
    {{/if}}

    <section class="post-content gh-content">
        {{content}}
    </section>
</article>
{{/post}}
