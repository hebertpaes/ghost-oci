<article class="post-card {{post_class}}{{#unless feature_image}} no-image{{/unless}}">
    <a class="post-card-link" href="{{url}}" aria-label="{{title}}">
        {{#if feature_image}}
            <div class="post-card-image-wrap">
                <img class="post-card-image"
                     srcset="{{img_url feature_image size="s"}} 400w, {{img_url feature_image size="m"}} 750w, {{img_url feature_image size="l"}} 1000w"
                     sizes="(max-width: 700px) 100vw, 350px"
                     src="{{img_url feature_image size="m"}}"
                     alt="{{title}}" loading="lazy">
            </div>
        {{/if}}
        <div class="post-card-content">
            {{#primary_tag}}<span class="post-card-tag">{{name}}</span>{{/primary_tag}}
            <h2 class="post-card-title">{{title}}</h2>
            <p class="post-card-excerpt">{{excerpt characters="120"}}</p>
            <div class="post-card-meta">
                {{#if @custom.mostrar_autor}}{{#primary_author}}<span class="post-card-author">{{name}}</span>{{/primary_author}} &middot; {{/if}}
                <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMM YYYY"}}</time>
                {{#if reading_time}} &middot; {{reading_time}}{{/if}}
            </div>
        </div>
    </a>
</article>
